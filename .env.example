# Resend (https://resend.com) — email delivery for the contact form.
RESEND_API_KEY=
# Inbox that receives the web enquiries. Until a domain is verified in Resend, this must be the
# same address the Resend account was created with.
CONTACT_TO_EMAIL=
# Sender on a verified domain, e.g. "Coffee Dreams <web@coffeedreams.es>". Leave empty to use
# Resend's test sender; the acknowledgement email to the client is only sent once this is set.
CONTACT_FROM_EMAIL=

# Stripe (https://dashboard.stripe.com/test/apikeys) — course payments via Stripe Checkout.
# Use sk_test_... while developing; switch to the client's sk_live_... in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/stripe/webhook). Locally it's printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`; in production, from Dashboard > Webhooks.
STRIPE_WEBHOOK_SECRET=
# Public site URL used for Stripe's return links, e.g. https://coffeedreams.es. Optional locally.
SITE_URL=
