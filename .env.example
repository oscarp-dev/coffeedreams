# Resend (https://resend.com) — email delivery for the contact form.
RESEND_API_KEY=
# Inbox that receives the web enquiries. Until a domain is verified in Resend, this must be the
# same address the Resend account was created with.
CONTACT_TO_EMAIL=
# Sender on a verified domain, e.g. "Coffee Dreams <web@coffeedreams.es>". Leave empty to use
# Resend's test sender; the acknowledgement email to the client is only sent once this is set.
CONTACT_FROM_EMAIL=
